# WebSpend server configuration. Copy to server/.env for local development.

# Port the API listens on.
PORT=8787

# Postgres connection string. Leave unset to use the embedded PGlite database instead.
# DATABASE_URL=postgres://user:pass@localhost:5432/webspend

# Where PGlite keeps its files, relative to the server folder.
PGLITE_DIR=data/webspend

# The URL the server is reached at. Google redirects back to <PUBLIC_URL>/auth/google/callback.
PUBLIC_URL=http://localhost:8787

# The web dashboard's origin, allowed for CORS with credentials.
WEB_ORIGIN=http://localhost:5173

# Google OAuth client (web application type). Both are needed for Google sign-in and Gmail polling.
# Scopes requested: openid email https://www.googleapis.com/auth/gmail.readonly
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 1 enables POST /auth/dev, a sign-in that needs no Google account. Defaults to on unless
# NODE_ENV=production.
DEV_AUTH=1

# Shared secret for POST /api/intake/email (the forwarding-address path). Unset disables the route.
# INTAKE_SECRET=

# How often the Gmail poller checks each mailbox.
POLL_INTERVAL_SECONDS=60

# Exchange rates: open-er-api (https://open.er-api.com, no key) or fixed.
RATE_SOURCE=open-er-api
# Units per US dollar, used when RATE_SOURCE=fixed.
FIXED_RATES=NGN:1500,GBP:0.78,EUR:0.92

# A balance drop up to this many minor units (kobo) unexplained by alerts is logged as a bank fee.
# Bigger differences become gaps. 50000 = ₦500.
FEE_THRESHOLD_MINOR=50000
